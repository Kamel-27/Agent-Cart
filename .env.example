# ---------------------------------------------------------------------------
# Extraction provider: anthropic | gemini | none
#
#   none      Heuristics only. No API key, no cost. Fills roughly the fields
#             that are recoverable from titles and WooCommerce attributes
#             (brand, ram_gb, storage_gb, color, 5g, dual_sim). Everything
#             else stays null. Good for a first run and for CI.
#
#   gemini    Free tier. Set GEMINI_API_KEY. Good Arabic. See docs/INGESTION.md.
#
#   anthropic Paid, highest extraction accuracy and native structured outputs.
#             Set ANTHROPIC_API_KEY.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Concurrent LLM requests. Lower this if you hit free-tier rate limits.
INGEST_CONCURRENCY=4

# Source catalog.
SOURCE_BASE_URL=https://elhashimstore.com

# ---------------------------------------------------------------------------
# Database
#
# Leave DATABASE_URL unset to use PGlite, a file-backed Postgres that runs
# in-process from .data/pg. Zero setup — but it is single-process, so you must
# stop `npm run dev` before running `npm run seed`.
#
# Set it to a real Postgres (Supabase and Neon both have free tiers with
# pgvector, which Phase 3 will need) and that restriction disappears.
#   DATABASE_URL=postgresql://user:pass@host/db
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Stripe (optional)
#
# Unset: checkout records a clearly-labelled demo order and empties the cart,
# so the whole storefront is usable without a Stripe account.
# Set: checkout redirects to hosted Stripe Checkout. Card data never reaches
# this server, which keeps the project out of PCI scope entirely.
#
# The webhook secret is what makes an order `paid`. Without it, orders stay
# `pending` after payment — the success redirect is never treated as proof.
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
