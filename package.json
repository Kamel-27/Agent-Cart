{
  "name": "agent-cart",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch": "tsx scripts/fetch.ts",
    "build:catalog": "tsx scripts/build-catalog.ts",
